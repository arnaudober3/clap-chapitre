{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "plan.json",
  "description": "Implementation plan produced by /plan. Consumed by /implement and /review.",
  "type": "object",
  "required": ["feature", "linear_issue", "spec", "status", "tasks"],
  "properties": {
    "feature": { "type": "string", "description": "Slug tying artifacts together, e.g. ENG-123-dark-mode" },
    "linear_issue": { "type": "string", "description": "Linear issue identifier, e.g. ENG-123" },
    "spec": { "type": "string", "description": "Path to the human-readable spec, e.g. specs/ENG-123-dark-mode.md" },
    "created": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["planned", "implementing", "reviewing", "testing", "done"] },
    "tasks": {
      "type": "array",
      "description": "Ordered mini-tasks. Each is small enough for one focused pass.",
      "items": {
        "type": "object",
        "required": ["id", "title", "scope", "acceptance_criteria", "tests"],
        "properties": {
          "id": { "type": "string", "description": "e.g. MS-1" },
          "title": { "type": "string" },
          "scope": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Glob(s) this task is allowed to touch. Writes outside = stop."
          },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
          "tests": {
            "type": "array",
            "items": { "type": "string" },
            "description": "One line per test to write, phrased as the behavior it proves."
          }
        }
      }
    },
    "out_of_scope": { "type": "array", "items": { "type": "string" } },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["q", "owner"],
        "properties": {
          "q": { "type": "string" },
          "owner": { "type": "string" },
          "due": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
