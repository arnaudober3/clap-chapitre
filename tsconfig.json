{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  /* functions/** is pulled in transitively through src/test/api-server.ts, which
     is the intended safety net: the client tests exercise the real handlers.
     vite.config.ts and vite/** are covered by tsconfig.node.json, functions/**
     on its own by tsconfig.functions.json — see the `typecheck` script. */
  "include": ["src"]
}
